<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- xUnit v3 test projects are executables hosted by Microsoft.Testing.Platform. -->
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>OpenMBEE.OpenSysML.Tests</AssemblyName>
    <RootNamespace>OpenMBEE.OpenSysML.Tests</RootNamespace>
    <!-- Test classes are public for xUnit, not API: no XML documentation is required of them. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OpenMBEE.OpenSysML/OpenMBEE.OpenSysML.csproj" />
    <!-- Built first, but not copied here: FakeChild runs it from its own output, as a separate process. -->
    <ProjectReference Include="../FakeService/FakeService.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
</Project>
